PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/interview_differently
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=your_key_here
CLERK_SECRET_KEY=your_key_here
OPENAI_API_KEY=your_key_here
DID_API_KEY=your_key_here

# The owner, for Prisma's CLI (migrate), the seed and the scripts. DATABASE_URL above is the restricted role the API
# connects as (create it with scripts/create-app-role.ts), so row-level security applies. See docs/tenant-isolation.md.
# Without a restricted role yet, set both to the same URL: the API then runs without row-level security.
SCHEMA_DATABASE_URL=postgresql://user:password@localhost:5432/interview_differently

# Micro Learning (Spark): where its lesson player (apps/spark) runs, and the secret that signs the lesson links the
# LMS embeds. Both are set only on the API service (Railway variables of api-dev and production). The player has no
# site of its own: the Learn Differently build publishes it at /spark/, so SPARK_WEB_URL (no trailing slash; the API
# adds /lesson) is http://localhost:5175 locally (the Spark dev server), https://<Learn preview address>/spark on
# api-dev and https://learndifferently.tech/spark in production. The secret is a random value
# (`openssl rand -base64 48`; never commit a real one). Outside production, without a secret (or with this
# placeholder) the API makes a random one per process, so links break on restart; in production (NODE_ENV=production)
# lessons then fail with "Lessons are not set up on this server" until it is set.
# The model that writes lessons, and the macOS voice for narration on a Mac, are optional.
SPARK_WEB_URL=http://localhost:5175
SPARK_SESSION_SECRET=replace_with_a_long_random_string
# SPARK_LESSON_MODEL=claude-sonnet-5-5
# SPARK_SAY_VOICE=Samantha
