{
  "name": "@id/api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src prisma scripts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "backfill:media": "ts-node -r tsconfig-paths/register scripts/backfill-scenario-media.ts",
    "seed:fake": "ts-node -r tsconfig-paths/register scripts/seed-fake-cohort.ts",
    "remap:user": "ts-node -r tsconfig-paths/register scripts/remap-user-ids.ts",
    "seed:attention-demo": "ts-node -r tsconfig-paths/register scripts/seed-attention-demo.ts",
    "seed:learn-demo": "ts-node -r tsconfig-paths/register scripts/seed-learn-demo.ts",
    "seed:adaptive-demo": "ts-node -r tsconfig-paths/register scripts/seed-adaptive-demo.ts",
    "mock:lti-tool": "ts-node -r tsconfig-paths/register scripts/mock-lti-tool.ts",
    "seed:lti-tools": "ts-node -r tsconfig-paths/register scripts/seed-lti-tools.ts",
    "set:featured-demos": "ts-node -r tsconfig-paths/register scripts/set-featured-demos.ts",
    "seed:lti-platforms": "ts-node -r tsconfig-paths/register scripts/seed-lti-platforms.ts",
    "sync:types": "node scripts/sync-learn-types.mjs",
    "railway:lti-vars": "node scripts/railway-lti-vars.mjs"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@clerk/backend": "^3.4.4",
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.1.0",
    "dotenv": "^17.4.1",
    "fflate": "^0.8.3",
    "js-yaml": "^4.1.1",
    "openai": "^6.34.0",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.12.2",
    "rxjs": "^7.8.0",
    "scorm-again": "3.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^12.0.9",
    "@nestjs/schematics": "^12.0.9",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.5.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0"
  }
}
