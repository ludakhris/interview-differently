generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scenario {
  scenarioId    String       @id
  status        String       @default("draft")
  data          Json
  institutionId String? // null = public to every user; set = private to that institution's members (#15)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId])
}

// Written when a user mounts the play page for a traditional simulation
// (immersive sims have their own ImmersiveSession with status tracking).
// Lets analytics compute completion rate as
//   count(SimulationResult in scope) / count(SimulationAttempt in scope)
// without needing a status column on SimulationResult.
//
// One row per page mount. React StrictMode double-mounts are deduped on the
// frontend via a ref, not here — keeping the table dumb is intentional.
model SimulationAttempt {
  id         String   @id @default(uuid())
  userId     String
  scenarioId String
  track      String                          // denormalised for fast per-track stats
  startedAt  DateTime @default(now())

  @@index([userId])
  @@index([scenarioId])
  @@index([userId, scenarioId])
}

model SimulationResult {
  id              String           @id
  userId          String
  scenarioId      String
  scenarioTitle   String
  track           String
  completedAt     DateTime
  overallScore    Int
  choiceSequence  String[]
  aiFeedback      Json?
  createdAt       DateTime         @default(now())
  dimensionScores DimensionScore[]

  @@index([userId])
  @@index([userId, scenarioId])
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DimensionScore {
  id                 String           @id @default(uuid())
  simulationResultId String
  dimension          String
  score              Int
  quality            String
  feedback           String
  simulationResult   SimulationResult @relation(fields: [simulationResultId], references: [id], onDelete: Cascade)

  @@index([simulationResultId])
}

model ImmersiveSession {
  id         String               @id @default(uuid())
  scenarioId String
  userId     String
  status     String               @default("active") // active | completed | abandoned
  summary    Json?                // cached ImmersiveSummary once all responses are evaluated
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  responses  ImmersiveResponse[]

  @@index([userId])
  @@index([scenarioId])
}

model ImmersiveResponse {
  id              String           @id @default(uuid())
  sessionId       String
  nodeId          String
  questionText    String
  mediaUrl        String?
  transcript      String?
  durationSeconds Int?
  aiFeedback      Json?            // cached ImmersiveResponseFeedback
  createdAt       DateTime         @default(now())
  session         ImmersiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ScenarioRequest {
  id               String   @id @default(uuid())
  // Briefing
  situation        String                            // required
  role             String?
  reportsTo        String?
  timeInRole       String?
  // Scenario context
  otherPeople      String?
  metricsContext   String?
  timePressure     String?
  hardestMoment    String                            // required
  temptingWrong    String?
  greatLooksLike   String?
  // Categorisation
  track            String?  // operations | business | risk | customer-success | general | custom
  estimatedMinutes Int?
  // Contact (all optional — anonymous submissions allowed)
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  // Triage
  status           String   @default("new")          // new | contacted | building | published | declined
  emailSent        Boolean  @default(false)
  emailError       String?
  notes            String?
  // System
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ── Institution analytics (Phase 6) ────────────────────────────────────────
//
// Institutions group cohorts; cohorts group students. Both are pure grouping
// mechanisms — a single user can belong to multiple cohorts (and therefore
// multiple institutions), so Membership is many-to-many.
//
// User is a thin local mirror of the Clerk user, populated lazily on first
// interaction with institution endpoints. We cache email/name so analytics
// queries don't have to round-trip to Clerk for every name lookup.

model User {
  id          String       @id              // Clerk userId — no separate uuid
  email       String?                       // cached from Clerk; nullable until first sync
  // Which Clerk instance issued this id: 'interview' (Interview Differently) or
  // 'learn' (LearnDifferently). Someone with both apps has two rows, so email is
  // unique per source rather than globally.
  source      String       @default("interview")
  displayName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  enrollments Enrollment[]

  @@unique([email, source])
  @@index([email])
}

model Institution {
  id          String       @id @default(uuid())
  name        String
  // Optional. When set, students whose Clerk email matches this domain
  // (or any subdomain of it) can be auto-suggested into the institution
  // at signup. When null, the only way in is the cohort joinKey or
  // admin-add. Indexed (not unique) — multiple institutions can legitimately
  // share a parent domain (e.g. both "harvard.edu" and "law.harvard.edu"
  // could exist, with longest-match-wins on the suggestion side).
  emailDomain String?
  // LearnDifferently tenancy (#46). An institution is a tenant: it owns the
  // learner data for the cohorts it runs. 'academic' = college or university;
  // 'organization' = nonprofit or other organization that runs cohorts; 'provider' =
  // authors courses and offers them to the others; 'agency' = oversees
  // providers (parentId points at it) and reads outcomes. Free text, not an
  // enum, so new kinds need no migration.
  kind        String       @default("organization") // 'academic' | 'organization' | 'provider' | 'agency'
  subdomain   String?      @unique            // {subdomain}.learndifferently.tech
  brand       Json?                            // { primary, accent, logoUrl, ... }
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parent      Institution?  @relation("InstitutionParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Institution[] @relation("InstitutionParent")
  cohorts     Cohort[]
  memberships Membership[]
  datasets    Dataset[]
  assessments Assessment[]
  scenarios   Scenario[]
  courses     Course[]
  offers      CourseOffer[]

  @@index([emailDomain])
  @@index([parentId])
}

model Cohort {
  id            String       @id @default(uuid())
  institutionId String
  name          String
  // Optional — students enter this at signup to auto-join. Globally unique
  // (decided 2026-09-13, closes #16): a key identifies exactly one cohort, so
  // the join flow never has to disambiguate between institutions.
  joinKey       String?      @unique
  // LearnDifferently (#46): a cohort is one course, one roster, one start date
  // and a fixed length. All null for Interview Differently cohorts.
  courseId      String?
  startsAt      DateTime?
  endsAt        DateTime?
  // Most learners that may be enrolled (withdrawn ones do not count). Null = no limit.
  maxLearners   Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  memberships   Membership[]
  datasets      CohortDataset[]
  tools         CohortToolConfig[]
  deliveries    AssessmentDelivery[]
  enrollments   Enrollment[]

  @@index([institutionId])
  @@index([courseId])
}

model Membership {
  id            String      @id @default(uuid())
  userId        String                          // Clerk userId — FK to User.id
  institutionId String
  cohortId      String?                          // null = institution member but no cohort yet
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  cohort        Cohort?     @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@unique([userId, institutionId, cohortId])  // a user can only be in a given (institution, cohort) once
  @@index([userId])
  @@index([institutionId])
  @@index([cohortId])
}

model ScenarioMediaAsset {
  id           String   @id @default(uuid())
  scenarioId   String
  nodeId       String
  scriptHash   String   // sha256 of audioScript at render time; mismatch ⇒ stale ⇒ re-render
  presenterId  String   // D-ID presenter id baked into the clip
  voiceId      String   // Azure voice id baked into the clip
  status       String   // queued | rendering | ready | failed
  mediaUrl     String?  // R2 public URL once status='ready'
  durationMs   Int?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scenarioId, nodeId])
  @@index([scenarioId])
  @@index([status])
}

// ── Tools (#25) ─────────────────────────────────────────────────────────────
//
// Tools are cohort-scoped feature flags. A cohort sees a tool only when an
// admin has explicitly enabled it here — assigning datasets or scheduling an
// assessment is not enough on its own. Known keys live in src/tools/tool-keys.ts.

model CohortToolConfig {
  cohortId  String
  toolKey   String   // 'sql-sandbox' | 'assessments'
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([cohortId, toolKey])
}

// ── Tools: SQL datasets ─────────────────────────────────────────────────────
//
// A Dataset is a self-contained Postgres setup script. Every PGlite instance
// (browser sandbox or server-side grader) starts empty and runs `setupSql`,
// so every student sees identical data. `setupHash` lets later attempts pin
// the exact script they were graded against.

model Dataset {
  id            String          @id @default(uuid())
  slug          String          @unique
  name          String
  description   String?
  dialect       String          @default("postgres") // reserved — only postgres runs today
  setupSql      String
  setupHash     String // sha256 of setupSql
  schemaSummary Json // [{ table, columns: [{ name, type }], rowCount }] introspected on save
  institutionId String? // null = platform-wide (authored by a full admin); set = owned by that institution (#25 Phase 5)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  institution   Institution?    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  cohorts       CohortDataset[]
  assessments   Assessment[]

  @@index([institutionId])
}

// Which datasets a cohort can open in the SQL sandbox. A cohort with at least
// one dataset has the sandbox tool enabled — there is no separate flag.
model CohortDataset {
  cohortId  String
  datasetId String
  createdAt DateTime @default(now())
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@id([cohortId, datasetId])
  @@index([datasetId])
}

// ── Tools: assessments ──────────────────────────────────────────────────────
//
// An Assessment is a question bank imported from markdown (see
// docs/assessment-format.md). A Delivery schedules it for one cohort with a
// label ("pre" / "post"), a window, and how many questions to draw per
// section. Each student gets one Attempt per delivery; the drawn question
// ids are fixed at start so a refresh doesn't reshuffle the paper.

model Assessment {
  id             String               @id @default(uuid())
  slug           String               @unique
  title          String
  datasetId      String?                                  // null = no Hands-On SQL questions, so no dataset
  sourceMarkdown String                                   // last imported markdown, re-import replaces
  sections       Json                                     // ParsedSection[] — see assessments/parse-markdown.ts
  defaultDraw    Json?                                    // frontmatter `draw`: total or per-type map (DrawSpec); null = every question
  expectedMinutes Int?                                   // frontmatter `expected_minutes`: designed duration, not a limit (#39)
  institutionId  String?                                  // null = platform-wide; see Dataset.institutionId
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  dataset        Dataset?             @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  institution    Institution?         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  deliveries     AssessmentDelivery[]

  @@index([datasetId])
  @@index([institutionId])
}

model AssessmentDelivery {
  id               String              @id @default(uuid())
  assessmentId     String
  cohortId         String?                                // null once the cohort is deleted — attempts stay with the student
  label            String                                 // 'pre' | 'post' | free text
  opensAt          DateTime?
  closesAt         DateTime?
  timeLimitMinutes Int?
  inviteCode       String?             @unique              // /a/<code> — join the cohort + start; null = no public link
  createdAt        DateTime            @default(now())
  assessment       Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  cohort           Cohort?             @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  attempts         AssessmentAttempt[]

  @@index([assessmentId])
  @@index([cohortId])
}

model AssessmentAttempt {
  id               String             @id @default(uuid())
  deliveryId       String
  userId           String
  datasetHash      String?                                // Dataset.setupHash at start — grading pins to this script; null = no dataset
  drawnQuestionIds Json                                   // string[] in paper order
  answers          Json                                   // Record<questionId, string> — MC letter or SQL text
  sectionScores    Json?                                  // SectionScore[] once submitted
  startedAt        DateTime           @default(now())
  submittedAt      DateTime?
  submittedLate    Boolean            @default(false)
  updatedAt        DateTime           @default(now()) @updatedAt // last autosave/submit — live progress (#40)
  delivery         AssessmentDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, userId])
  @@index([userId])
}

// ── LearnDifferently LMS (#46) ──────────────────────────────────────────────
//
// A provider institution authors Courses and offers them (CourseOffer) to
// member institutions. A member runs a Cohort of a course; learners join via
// Enrollment and their per-item results live in ItemProgress. One learner can
// be enrolled through several institutions. Pre/post scores, interview scores
// and completion all roll up from ItemProgress, so reports have one source.

model Course {
  id          String         @id @default(uuid())
  providerId  String
  slug        String         @unique
  title       String
  summary     String?
  sector      String?
  credential  String?
  lengthWeeks Int?
  // Best interview score (0-100) at or above which a learner counts as "interview
  // ready" in reports. Set by whoever authors the course.
  readinessThreshold Int         @default(70)
  // Post-assessment score (0-100) a learner must reach to count as meeting the
  // course target in reports. Set by whoever authors the course.
  targetScore Int                @default(80)
  // What a learner will be able to do, and the jobs the course prepares for. Shown in the catalog.
  outcomes    String[]           @default([])
  targetRoles String[]           @default([])
  // Skills the course builds, each with the pass mark (0-100) below which a learner is flagged
  // and the author's remediation content is added to their plan: [{ id, label, targetPct }].
  skills      Json               @default("[]")
  status      String         @default("published") // 'draft' | 'published'
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  provider    Institution    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modules     CourseModule[]
  offers      CourseOffer[]
  cohorts     Cohort[]

  @@index([providerId])
}

model CourseModule {
  id       String       @id @default(uuid())
  courseId String
  title    String
  position Int
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items    CourseItem[]

  @@index([courseId])
}

// type: 'lesson' | 'knowledge_check' | 'interview' | 'scorm'.
// `label` marks assessments as 'pre' or 'post'. `config` holds the type's
// payload or reference (lesson body, assessment slug, scenario id, SCORM package).
model CourseItem {
  id       String         @id @default(uuid())
  moduleId String
  type     String
  title    String
  position Int
  label    String?
  config   Json           @default("{}")
  module   CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress ItemProgress[]
  plan     PlanItem[]

  @@index([moduleId])
}

// A provider makes a course available to a member institution.
model CourseOffer {
  courseId      String
  institutionId String
  createdAt     DateTime    @default(now())
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([courseId, institutionId])
  @@index([institutionId])
}

model Enrollment {
  id          String         @id @default(uuid())
  cohortId    String
  userId      String
  status      String         @default("enrolled") // 'enrolled' | 'completed' | 'withdrawn'
  enrolledAt  DateTime       @default(now())
  completedAt DateTime?
  cohort      Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    ItemProgress[]
  plan        PlanItem[]

  @@unique([cohortId, userId])
  @@index([userId])
}

model ItemProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  itemId       String
  status       String     @default("not_started") // 'not_started' | 'in_progress' | 'completed'
  score        Int? // 0-100 for assessments, knowledge checks and interviews
  attempts     Int        @default(0)
  completedAt  DateTime?
  // SCORM runtime data (cmi), so a package can resume where the learner left off.
  data         Json?
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  item         CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, itemId])
  @@index([itemId])
}

// Content added to one learner's plan because a skill was flagged. The author's outline is
// the recipe; these rows are what a learner's results added to it. Required for completion.
model PlanItem {
  id           String     @id @default(uuid())
  enrollmentId String
  itemId       String
  // { skill, skillLabel, pct, n }: why it was added, shown to the learner.
  reason       Json
  seenAt       DateTime?
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  item         CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, itemId])
  @@index([itemId])
}

// ── Tools: SQL sandbox query log ────────────────────────────────────────────
//
// One row per query a student runs in the browser sandbox (PGlite runs
// client-side, so the client reports it). Lets admins monitor a cohort live.
// Stores raw student SQL — purged after 90 days (see ToolsService.logSandboxQuery).
// `userId` has no FK on purpose: log rows are independent of User lifecycle.

model SqlQueryLog {
  id           String   @id @default(uuid())
  userId       String
  cohortId     String?  // resolved server-side from the user's memberships
  datasetSlug  String
  queryText    String
  ok           Boolean
  errorMessage String?
  rowCount     Int?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([cohortId, createdAt])
  @@index([createdAt])
}

// ── Usage: page views (#42 Phase 2) ─────────────────────────────────────────
//
// One row per signed-in page view, so the admin usage dashboard can see
// browse-only visits and tool opens. `route` is a normalised pattern
// ("/tools/assessments/attempt/:id"), never the raw path, so ids and invite
// codes aren't stored (see usage/usage-route.ts). `refId` is only set for
// scenario routes. Purged after 90 days; `userId` has no FK on purpose.

model UsageEvent {
  id        String   @id @default(uuid())
  userId    String
  route     String
  refId     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// One registration with a tool vendor (#63): the client id the platform knows it by, and where its
// login, launch and key set live. Several tools can share one connection (a vendor with a practice
// lab and a graded assessment over the same server). Holds no secrets: the keys are fetched from
// jwksUrl.
model LtiConnection {
  id           String    @id
  name         String
  clientId     String    @unique
  deploymentId String
  loginUrl     String
  launchUrl    String
  jwksUrl      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tools        LtiTool[]
}

// A connected tool a course item may launch (#63): what it is and who may use it. Where it lives is
// its connection's.
model LtiTool {
  toolId       String        @id
  connectionId String
  connection   LtiConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  name         String
  kind         String // 'interview' | 'assessment'
  retries      Boolean
  labelable    Boolean
  enabled      Boolean       @default(true)
  // What the course editor calls the item's "Reference" for this tool, and how to find the value
  // (null: a generic label and help text).
  referenceLabel String?
  referenceHelp  String?
  // Institution ids (agencies or providers) that may use the tool; empty means every workspace.
  // A workspace is allowed when it, or the agency it reports to, is listed.
  workspaceIds String[]      @default([])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([connectionId])
}

// Who changed which connection or tool, and how (#63). One row per change, written in the same
// transaction as the change. subjectId is not a foreign key so the history of a removed one stays.
model LtiRegistryChange {
  id          String   @id @default(uuid())
  subject     String // 'connection' | 'tool'
  subjectId   String
  subjectName String
  action      String // 'created' | 'updated' | 'removed'
  userId      String? // null for the first-start setup
  userName    String // the person's name or email when they made the change
  // { field: { from, to } } for each field that changed (from is null on create, to on remove)
  changes     Json
  createdAt   DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([createdAt])
}

// Single-use and rate-limit state shared by every API instance for LTI (#63): launch hints,
// client-assertion ids, login state, submission tokens, request counters. One row per
// scope + key; expired rows are ignored on read and deleted opportunistically.
model LtiSingleUse {
  id        String   @id @default(uuid())
  scope     String
  key       String
  value     Json?
  count     Int      @default(1)
  expiresAt DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}
