{
  "buildCommand": "cd ../.. && npx turbo run build --filter=@id/learn",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/scorm/:path*", "destination": "https://media.interviewdifferently.com/learn-scorm/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "delaware.learndifferently.tech" }], "destination": "/delaware.html" },
    { "source": "/privacy", "has": [{ "type": "host", "value": "delaware.learndifferently.tech" }], "destination": "/delaware.html" },
    { "source": "/sign-in/:path*", "has": [{ "type": "host", "value": "delaware.learndifferently.tech" }], "destination": "/delaware.html" },
    { "source": "/dashboard/:path*", "has": [{ "type": "host", "value": "delaware.learndifferently.tech" }], "destination": "/delaware.html" },
    { "source": "/courses/:path*", "has": [{ "type": "host", "value": "delaware.learndifferently.tech" }], "destination": "/delaware.html" },
    { "source": "/dashboard/:path*", "destination": "/home.html" },
    { "source": "/cohorts/:path*", "has": [{ "type": "host", "value": "delaware.learndifferently.tech" }], "destination": "/delaware.html" },
    { "source": "/courses/:path*", "destination": "/home.html" },
    { "source": "/learning/:path*", "has": [{ "type": "host", "value": "delaware.learndifferently.tech" }], "destination": "/delaware.html" },
    { "source": "/catalog/:path*", "has": [{ "type": "host", "value": "delaware.learndifferently.tech" }], "destination": "/delaware.html" },
    { "source": "/cohorts/:path*", "destination": "/home.html" },
    { "source": "/learning/:path*", "destination": "/home.html" },
    { "source": "/catalog/:path*", "destination": "/home.html" },
    { "source": "/products/:path*", "destination": "/home.html" },
    { "source": "/", "destination": "/home.html" },
    { "source": "/privacy", "destination": "/home.html" },
    { "source": "/sign-in/:path*", "destination": "/home.html" }
  ]
}
