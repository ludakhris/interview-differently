{
  "buildCommand": "cd ../.. && npx turbo run build --filter=@id/learn",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/scorm/:path*",
      "destination": "https://media.interviewdifferently.com/learn-scorm/:path*"
    },
    {
      "source": "/lms/:path*",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/lms/:path*",
      "destination": "/home.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/sign-in/:path*",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/home.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/privacy",
      "destination": "/home.html"
    },
    {
      "source": "/sign-in/:path*",
      "destination": "/home.html"
    }
  ]
}
