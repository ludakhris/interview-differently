{
  "buildCommand": "cd ../.. && npx turbo run build --filter=@id/learn",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/spark/:path*",
      "destination": "/spark/index.html"
    },
    {
      "source": "/lms/:path*",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/lms/:path*",
      "destination": "/home.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/accessibility",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/sign-in/:path*",
      "has": [
        {
          "type": "host",
          "value": "delaware.learndifferently.tech"
        }
      ],
      "destination": "/delaware.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/home.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/privacy",
      "destination": "/home.html"
    },
    {
      "source": "/accessibility",
      "destination": "/home.html"
    },
    {
      "source": "/sign-in/:path*",
      "destination": "/home.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://*.clerk.accounts.dev https://*.learndifferently.tech https://*.interviewdifferently.com https://challenges.cloudflare.com https://vercel.live; connect-src 'self' https://*.interviewdifferently.com https://*.learndifferently.tech https://*.clerk.accounts.dev https://clerk-telemetry.com wss://*.clerk.accounts.dev; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://*.interviewdifferently.com https://*.learndifferently.tech https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://vercel.live; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/((?!spark/|scorm/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
